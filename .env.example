# Layer 3 is optional and provider-agnostic. Pick whichever you have.

# 1. Nothing at all - deterministic layers only:
#      python -m taper.cli --no-llm reconcile
#
# 2. A local model, no key and no cost (recommended for reviewers):
#      ollama serve
#      python -m taper.cli --llm ollama --llm-model qwen2.5:14b reconcile
#
# 3. Any OpenAI-compatible endpoint (Groq, OpenRouter, Together):
#      export LLM_API_KEY=...
#      python -m taper.cli --llm openai-compatible #          --llm-base-url https://api.groq.com/openai/v1 #          --llm-model llama-3.3-70b-versatile reconcile
#
# 4. Anthropic:
ANTHROPIC_API_KEY=sk-ant-...
